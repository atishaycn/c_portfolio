{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "clairethomas-site",
	"main": "worker/index.mjs",
	"compatibility_date": "2026-10-14",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"preview_urls": false,
	"routes": [
		{ "pattern": "clairethomas.art", "custom_domain": true },
		{ "pattern": "www.clairethomas.art", "custom_domain": true },
	],
	"vars": {
		"SHOP_OPEN_HOSTS": "clairethomas-site.phunnysunny.workers.dev",
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"html_handling": "none",
		"run_worker_first": ["/api/*"],
	},
}
