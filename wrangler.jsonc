{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "clairethomas-site",
	"main": "worker/index.mjs",
	"compatibility_date": "2026-10-14",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"html_handling": "none",
		"run_worker_first": ["/api/*"],
	},
}
