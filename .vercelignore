# Upload only what the site serves. Everything else in this folder (local
# credentials, .env files, sync state, original photos, scripts) stays local.
# CLI deploys previously served .admin-credentials.local.json; keep this an allowlist.
/*
!/api
!/assets
!/content
!/*.html
!/*.js
!/*.css
!/*.JPG
!/vercel.json
!/package.json
# Convex functions and the build step that deploys them (ADR 0002).
!/convex
!/package-lock.json
!/scripts
/scripts/*
!/scripts/vercel-build.mjs
