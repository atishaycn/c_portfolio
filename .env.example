CLOUDINARY_CLOUD_NAME=dpmdkrggj
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
CLOUDINARY_URL=cloudinary://your_api_key_here:your_api_secret_here@dpmdkrggj

GELATO_API_KEY=your_gelato_api_key_here
GELATO_STORE_ID=6d03ca64-de8a-4764-bc46-8bd014a1b271
GELATO_FINE_ART_TEMPLATE_ID=
GELATO_FRAMED_TEMPLATE_ID=
GELATO_CANVAS_TEMPLATE_ID=

# Required only for catalog reconcile mutations. The installed Shopify app needs
# read_products, write_products, read_publications, and write_publications scopes.
SHOPIFY_STORE_DOMAIN=esf4bj-wk.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07

# Optional CMS source override. The default is content/portfolio.json.
PORTFOLIO_CONTENT_FILE=
PORTFOLIO_CONTENT_URL=

# Booking form email (api/inquiry.js). The key needs Resend sending access for
# clairethomas.art; INQUIRY_FROM and INQUIRY_TO are optional overrides.
RESEND_API_KEY=
INQUIRY_FROM=Claire Thomas website <website@clairethomas.art>
INQUIRY_TO=contact@clairethomas.art

# Client intake (api/intake.js, api/intake-admin.js, convex/). See docs/adr/0001 and 0002.
# CONVEX_URL: Convex dev URL for Preview/local, prod URL for Production.
CONVEX_URL=
# Shared secret; set the same value in the Convex deployment (npx convex env set).
INTAKE_CONVEX_SECRET=
# 32 random bytes, base64. Encrypts stored link tokens so "Copy link" works.
INTAKE_LINK_KEY=
# Production only: lets the Vercel build run `npx convex deploy`.
CONVEX_DEPLOY_KEY=
# Optional: where submit notifications go (defaults to INQUIRY_TO).
INTAKE_NOTIFY_TO=
# Local preview only (npm run dev): password for claire@local.test.
INTAKE_LOCAL_ADMIN_PASSWORD=
