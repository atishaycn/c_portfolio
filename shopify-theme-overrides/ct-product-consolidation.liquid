{% comment %}
  Customer-facing presentation for one Fine Art product per photo.
  Include this file before </body> in layout/theme.liquid.
  Revision: 2026-08-19 San Francisco 93 Gelato-only pilot, mobile controls cleanup.
{% endcomment %}

<style>
  /* Horizon defaults product media to contain. These print previews are
     already aspect-ratio matched, so cover removes unused frame/letterbox
     space while limiting the crop to the media container. */
  .ct-print-card .product-media-container--image img,
  .ct-print-product .product-media-container--image:not(.dialog-zoomed-gallery *) .product-media__image {
    width: 100%;
    height: 100%;
    object-fit: cover !important;
    object-position: center center;
  }

  /* The reconcile script marks the original artwork with a stable alt prefix.
     Hide every Gelato mockup except the one for the selected size; retain the
     artwork as the secondary zoomable image. */
  .ct-print-product .ct-non-artwork-media {
    display: none !important;
  }

  /* Fine Art products keep Gelato's size-specific mockups available so
     Shopify can display the exact selected fulfillment variant. */
  .ct-print-product.ct-mockup-preview .ct-non-artwork-media {
    display: none !important;
  }

  .ct-print-product.ct-mockup-preview .ct-non-artwork-media.ct-selected-variant-media {
    display: block !important;
  }

  .ct-print-product.ct-mockup-preview .ct-non-artwork-media img {
    object-fit: contain !important;
    background: #f4f2ed;
  }

  .ct-gelato-only-pilot media-gallery .ct-artwork-media,
  .ct-gelato-only-pilot .dialog-zoomed-gallery .ct-artwork-media {
    display: none !important;
  }

  .ct-gelato-only-pilot media-gallery .media-gallery__grid {
    grid-template-columns: minmax(0, 1fr) !important;
  }

  .ct-gelato-only-pilot media-gallery .ct-selected-variant-media {
    grid-column: 1 / -1;
  }

  .ct-gelato-only-pilot media-gallery slideshow-controls {
    display: none !important;
  }

  .ct-original-photo-reference {
    margin: 0;
  }

  .ct-original-photo-reference a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  [data-ct-print-type] {
    display: none !important;
  }

  .product-grid__item[hidden],
  .resource-list__item[hidden],
  .predictive-search-results__card[hidden],
  .menu-drawer__featured-content-list-item[hidden],
  product-card[hidden],
  product-component[hidden] {
    display: none !important;
  }
</style>

<script>
  (() => {
    const formats = [
      { suffix: '-framed-fine-art-print', active: false },
      { suffix: '-canvas-print', active: false },
      { suffix: '-fine-art-print', active: true },
    ];
    const artworkMediaAltPrefix = 'Claire Thomas artwork:';
    const originalPhotoUrls = {
      'san-francisco-93-fine-art-print':
        'https://res.cloudinary.com/dpmdkrggj/image/upload/f_auto,q_auto,w_2400,c_limit/place/california/san-francisco/93',
    };
    let productDataPromise = null;
    let previewSyncToken = 0;

    const productHandle = (href) => {
      try {
        const pathname = new URL(href, window.location.origin).pathname;
        const handle = pathname.match(/\/products\/([^/]+)/)?.[1] || '';
        return decodeURIComponent(handle).replace(/\/$/, '').toLowerCase();
      } catch {
        return '';
      }
    };

    const stripShopifyDuplicateSuffix = (handle) => handle.replace(/-\d+$/, '');

    const normalizedHandle = (handle) => stripShopifyDuplicateSuffix(handle.toLowerCase());

    const formatForHandle = (handle) => {
      const canonicalHandle = normalizedHandle(handle);
      return formats.find((format) => canonicalHandle.endsWith(format.suffix));
    };

    const baseHandleFor = (handle) => {
      const canonicalHandle = normalizedHandle(handle);
      const format = formatForHandle(canonicalHandle);
      return format ? canonicalHandle.slice(0, -format.suffix.length) : '';
    };

    const duplicateRank = (handle) => Number(handle.match(/-(\d+)$/)?.[1] || 0);

    const artworkKeyFor = (card, handle) => {
      const tagSource =
        card.dataset.productTags ||
        card.getAttribute('data-product-tags') ||
        card.querySelector('[data-product-tags]')?.getAttribute('data-product-tags') ||
        card.closest?.('[data-product-tags]')?.getAttribute?.('data-product-tags') ||
        '';
      const artworkTag = tagSource
        .split(',')
        .map((tag) => tag.trim().toLowerCase())
        .find((tag) => tag.startsWith('photo-id:'));
      return artworkTag ? `tag:${artworkTag}` : `handle:${baseHandleFor(handle)}`;
    };

    const cleanTitle = (title) =>
      title.replace(/\s+-\s+(?:Framed Fine Art|Fine Art|Canvas) Print\s*$/, '').trim();

    const cleanCardTitle = (card) => {
      card.querySelectorAll('h1, h2, h3, a').forEach((element) => {
        const current = element.textContent?.trim() || '';
        const cleaned = cleanTitle(current);
        if (current && cleaned !== current && element.children.length === 0) element.textContent = cleaned;
      });
    };

    const consolidateProductCards = () => {
      const groupsByScope = new Map();
      document.querySelectorAll('.ct-print-card').forEach((card) => card.classList.remove('ct-print-card'));
      document
        .querySelectorAll('product-card, product-component.resource-card__wrapper, .resource-card__wrapper')
        .forEach((card) => {
          const link = card.querySelector('a[href*="/products/"]');
          const handle = productHandle(link?.href || '');
          const format = formatForHandle(handle);
          if (!format) return;

          const item =
            card.closest(
              '.product-grid__item, .resource-list__item, .predictive-search-results__card, .menu-drawer__featured-content-list-item',
            ) || card;
          const scope = item.parentElement || card.parentElement || document.body;
          const baseHandle = artworkKeyFor(card, handle);
          if (!groupsByScope.has(scope)) groupsByScope.set(scope, new Map());
          const groups = groupsByScope.get(scope);
          if (!groups.has(baseHandle)) groups.set(baseHandle, []);
          groups.get(baseHandle).push({ card, item, format, handle });
        });

      groupsByScope.forEach((groups) => {
        groups.forEach((entries) => {
          const fineArt =
            entries
              .filter(({ format }) => format.suffix === '-fine-art-print')
              .sort((left, right) => duplicateRank(left.handle) - duplicateRank(right.handle))[0] || null;
          const isPaginatedListing = entries.some(({ item }) =>
            item.matches?.('.product-grid__item, .resource-list__item'),
          );
          const chosen =
            fineArt ||
            (isPaginatedListing
              ? null
              : entries.slice().sort((left, right) => duplicateRank(left.handle) - duplicateRank(right.handle))[0]);
          entries.forEach((entry) => {
            entry.item.hidden = entry !== chosen;
          });
          if (!chosen) return;
          chosen.card.classList.add('ct-print-card');
          cleanCardTitle(chosen.card);
        });
      });
    };

    const enforceContactRequirements = () => {
      document
        .querySelectorAll('main input[type="email"][name="contact[email]"]')
        .forEach((input) => {
          input.required = true;
          input.setAttribute('aria-required', 'true');
        });
    };

    const originalPhotoUrlForHandle = (handle) => originalPhotoUrls[normalizedHandle(handle)] || '';

    const addOriginalPhotoReference = () => {
      const handle = productHandle(window.location.pathname);
      const originalPhotoUrl = originalPhotoUrlForHandle(handle);
      document.documentElement.classList.toggle('ct-gelato-only-pilot', Boolean(originalPhotoUrl));

      let reference = document.querySelector('[data-ct-original-photo-reference]');
      if (!originalPhotoUrl) {
        reference?.remove();
        return;
      }

      if (!reference) {
        const variantPicker = document.querySelector('main variant-picker');
        if (!variantPicker) return;
        reference = document.createElement('p');
        reference.className = 'ct-original-photo-reference';
        reference.dataset.ctOriginalPhotoReference = '';
        const link = document.createElement('a');
        link.textContent = 'View original photograph';
        link.target = '_blank';
        link.rel = 'noreferrer';
        reference.append(link);
        variantPicker.insertAdjacentElement('afterend', reference);
      }

      reference.querySelector('a').href = originalPhotoUrl;
    };

    const filterProductMedia = () => {
      const isPrintProduct = document.documentElement.classList.contains('ct-print-product');
      const containers = [
        ...document.querySelectorAll('.product-media-container--image, .ct-non-artwork-media'),
      ];
      const hasArtwork = containers.some((container) =>
        (container.querySelector('img')?.alt || '')
          .trim()
          .toLowerCase()
          .startsWith(artworkMediaAltPrefix.toLowerCase()),
      );
      containers.forEach((container) => {
        if (!isPrintProduct || !hasArtwork) {
          container.classList.remove('ct-non-artwork-media', 'ct-artwork-media');
          container.closest('li')?.classList.remove('ct-non-artwork-media', 'ct-artwork-media');
          return;
        }
        const image = container.querySelector('img');
        const isArtwork = (image?.alt || '').trim().toLowerCase().startsWith(artworkMediaAltPrefix.toLowerCase());
        const targets = new Set([container, container.closest('li')].filter(Boolean));
        targets.forEach((target) => {
          target.classList.toggle('ct-artwork-media', isArtwork);
          target.classList.toggle('ct-non-artwork-media', !isArtwork);
        });
      });
    };

    const loadProductData = () => {
      if (!productDataPromise) {
        productDataPromise = fetch(`${window.location.pathname}.js`)
          .then((response) => response.ok ? response.json() : null)
          .catch(() => null);
      }
      return productDataPromise;
    };

    const applySelectedMockup = (selectedMediaAlt) => {
      document.querySelectorAll('.ct-non-artwork-media').forEach((container) => {
        const imageAlt = container.querySelector('img')?.alt?.trim() || '';
        const target = container.closest('li') || container;
        target.classList.toggle(
          'ct-selected-variant-media',
          Boolean(selectedMediaAlt && imageAlt === selectedMediaAlt),
        );
      });
    };

    const syncVariantPreview = async () => {
      if (!document.documentElement.classList.contains('ct-mockup-preview')) return;

      const syncToken = ++previewSyncToken;
      const variantPayload = document.querySelector(
        'main variant-picker form.variant-picker__form script[type="application/json"]',
      );
      let selectedMediaAlt = '';
      try {
        selectedMediaAlt = JSON.parse(variantPayload?.textContent || '{}').featured_media?.alt || '';
      } catch {
        selectedMediaAlt = '';
      }
      applySelectedMockup(selectedMediaAlt);

      const selectedVariantId = Number(
		document.querySelector('main variant-picker input[type="radio"]:checked')?.dataset?.variantId,
      );
      if (!selectedVariantId) return;
      const productData = await loadProductData();
      if (syncToken !== previewSyncToken) return;
      const selectedVariant = productData?.variants?.find((variant) => variant.id === selectedVariantId);
      applySelectedMockup(selectedVariant?.featured_media?.alt || selectedMediaAlt);
    };

    const addPrintTypeChooser = () => {
      const handle = productHandle(window.location.pathname);
      const currentFormat = formatForHandle(handle);
      const isFineArt = Boolean(currentFormat?.active);
      document.documentElement.classList.toggle('ct-print-product', isFineArt);
      document.documentElement.classList.toggle(
        'ct-mockup-preview',
        isFineArt,
      );
      const legacyPrintTypeChooser = document.querySelector('[data-ct-print-type]');
      if (legacyPrintTypeChooser) legacyPrintTypeChooser.hidden = true;
      if (!isFineArt) return;

      const heading = document.querySelector('main h1');
      const fullTitle = heading?.textContent?.trim() || '';
      const photoTitle = cleanTitle(fullTitle);
      if (heading && photoTitle) heading.textContent = photoTitle;
      document.querySelectorAll('main p').forEach((paragraph) => {
        if (paragraph.textContent?.trim() === fullTitle) paragraph.textContent = photoTitle;
      });

    };

    let scheduled = false;
    const enhanceStorefront = () => {
      consolidateProductCards();
      addPrintTypeChooser();
      addOriginalPhotoReference();
      filterProductMedia();
      syncVariantPreview();
      enforceContactRequirements();
    };
    const scheduleEnhancement = () => {
      if (scheduled) return;
      scheduled = true;
      window.requestAnimationFrame(() => {
        scheduled = false;
        enhanceStorefront();
      });
    };

    enhanceStorefront();
    document.addEventListener('DOMContentLoaded', enhanceStorefront, { once: true });
    document.addEventListener('change', () => window.setTimeout(enhanceStorefront, 0));
    new MutationObserver(scheduleEnhancement).observe(document.documentElement, {
      childList: true,
      subtree: true,
    });
  })();
</script>
